# Carrito GT API (FastAPI) — copia a api/.env en el servidor (NO subir a git)
# Compatible con Python 3.10 en el Chat Center (Ubuntu 22.04)

# --- Postgres (Chat Center) ---
CAR_DB_HOST=127.0.0.1
CAR_DB_PORT=5432
CAR_DB_NAME=chat_center_gt
CAR_DB_USER=crm_gt_app
CAR_DB_PASSWORD=change-me
# Si usas URL completa, tiene prioridad sobre los campos anteriores:
# CAR_DATABASE_URL=postgresql+psycopg2://user:pass@127.0.0.1:5432/chat_center_gt

# --- Seguridad ---
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(48))"
CAR_API_TOKENS=replace-with-long-random-token-1,replace-with-long-random-token-2
CAR_REQUIRE_HTTPS=true
# Lista opcional de IPs/CIDR permitidas (vacío = todas, solo tras TLS + token)
CAR_IP_ALLOWLIST=
# Rate limit simple por token (requests / ventana)
CAR_RATE_LIMIT_PER_MINUTE=120

# --- App ---
CAR_API_HOST=127.0.0.1
CAR_API_PORT=8787
CAR_API_TITLE=Carrito GT API
CAR_API_VERSION=0.1.0
CAR_CORS_ORIGINS=chrome-extension://YOUR_EXTENSION_ID
