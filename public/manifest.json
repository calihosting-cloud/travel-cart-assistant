{
  "manifest_version": 3,
  "name": "Travel Cart Assistant GT",
  "version": "1.1.63",
  "description": "Carrito GT — BookingMotor (hoteles, traslados, actividades, seguros, circuitos), Despegar, XNet, Avianca, Wingo, JetSMART, Arajet, Chat Center",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://chatcrm.grupostravel.com/*",
    "https://www.dolar-colombia.com/*",
    "https://dolar.wilkinsonpc.com.co/*",
    "https://staticmap.openstreetmap.de/*",
    "https://static-maps.yandex.ru/*",
    "https://images.kiwi.com/*"
  ],
  "action": {
    "default_title": "Carrito GT — Grupos Travel",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "log.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://reservas.grupostravel.com/*",
        "https://chatcrm.grupostravel.com/*",
        "https://www.despegar.com.co/*",
        "https://*.despegar.com.co/*",
        "https://scape.xnet.travel/*",
        "https://*.xnet.travel/*",
        "https://booking.avianca.com/*",
        "https://*.avianca.com/*",
        "https://www.avianca.com/*",
        "https://booking.wingo.com/*",
        "https://*.wingo.com/*",
        "https://booking.jetsmart.com/*",
        "https://*.jetsmart.com/*",
        "https://jetsmart.com/*",
        "https://www.jetsmart.com/*",
        "https://www.arajet.com/*",
        "https://arajet.com/*",
        "https://*.arajet.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file://*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["bridge.js"],
      "matches": [
        "https://reservas.grupostravel.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file://*/*"
      ]
    }
  ]
}
