{
  "manifest_version": 3,
  "name": "Travel Cart Assistant GT",
  "version": "1.0.34",
  "description": "Carrito GT — BookingMotor, Despegar, XNet, Avianca, Wingo, JetSMART",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://www.dolar-colombia.com/*"
  ],
  "action": {
    "default_title": "Carrito GT — dominios habilitados",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "log.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://reservas.grupostravel.com/*",
        "https://www.despegar.com.co/*",
        "https://*.despegar.com.co/*",
        "https://scape.xnet.travel/*",
        "https://*.xnet.travel/*",
        "https://booking.avianca.com/*",
        "https://*.avianca.com/*",
        "https://www.avianca.com/*",
        "https://booking.wingo.com/*",
        "https://*.wingo.com/*",
        "https://booking.jetsmart.com/*",
        "https://*.jetsmart.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file://*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["bridge.js"],
      "matches": [
        "https://reservas.grupostravel.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file://*/*"
      ]
    }
  ]
}
